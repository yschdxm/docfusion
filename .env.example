# ============================================
# 环境变量配置模板
# 复制此文件为 .env 并填写真实的配置
# ============================================

# ============================================
# 应用配置（必填）
# ============================================

# 生产环境请更换为随机生成的强密钥
SECRET_KEY=your_secret_key_here

# 允许的主机名，* 表示允许所有主机
# 生产环境建议设置为具体域名，格式: domain1,domain2,ip1,ip2
ALLOWED_HOSTS=*

# 生产环境必须设置为 false
DEBUG=false

# ============================================
# backend 容器资源限制（docker-compose deploy）
# ============================================
# 注意：CPU 上限不能超过宿主机核数，否则容器创建失败
# 例如 2 核服务器：BACKEND_CPU_LIMIT=2.0
BACKEND_CPU_LIMIT=2.0
BACKEND_MEMORY_LIMIT=12G
BACKEND_CPU_RESERVATION=0.5
BACKEND_MEMORY_RESERVATION=4G

# ============================================
# 数据库配置（生产环境必须修改密码！）
# ============================================
POSTGRES_PASSWORD=your_strong_postgres_password
NEO4J_PASSWORD=your_strong_neo4j_password

# ============================================
# SSL 配置
# ============================================
# SSL验证总开关（默认开启）
SSL_VERIFY=true

# ============================================
# 日志级别配置
# ============================================
# 可选值: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_LEVEL_DB=WARNING
LOG_LEVEL_SERVICE=INFO
LOG_LEVEL_API=INFO
LOG_LEVEL_LLM=INFO
LOG_LEVEL_KG=INFO
LOG_LEVEL_RAG=INFO
LOG_LEVEL_UVICORN=WARNING
LOG_LEVEL_SQLALCHEMY=WARNING
LOG_LEVEL_NEO4J_DRIVER=WARNING

# ============================================
# 管理员配置（可选）
# ============================================
# 首次启动时自动创建主管理员账号
# 如果不配置，系统会将第一个注册的用户设为主管理员
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password_here

# ============================================
# 模型配置说明
# ============================================
# 所有模型配置（LLM、嵌入、重排）现在通过管理中心在数据库中配置
# 支持任意 OpenAI 兼容的 API
# 首次启动后请访问 /admin 页面进行配置

# ============================================
# Tencent Agent Mail / agently-cli 配置（可选）
# ============================================
# agently-cli 命令路径，如不在 PATH 中可改为完整路径
AGENTLY_CLI_BIN=agently-cli

# 邮件收取/读取/附件下载命令
# 注意：值必须用单引号包裹，否则 docker compose 会把 $limit 等当作变量插值并刷警告
AGENTLY_MAIL_LIST_COMMAND='agently-cli message +list --dir inbox --limit $limit'
AGENTLY_MAIL_DETAIL_COMMAND='agently-cli message +read --id $message_id'
AGENTLY_MAIL_SEND_COMMAND='agently-cli message +send --to $to --subject $subject --body $body'
AGENTLY_MAIL_ATTACHMENT_COMMAND='agently-cli attachment +download --msg $message_id --att $attachment_id --output $output_dir'
AGENTLY_MAIL_TIMEOUT_SECONDS=120

# Agently OAuth 配置（用于多用户授权）
# 通过 agently-cli 处理 OAuth，通常不需要修改
# AGENTLY_OAUTH_LOGOUT_URL=https://auth.agent.qq.com/oauth/logout_session
