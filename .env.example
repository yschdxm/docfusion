# ============================================
# 环境变量配置模板
# 复制此文件为 .env 并填写真实的 API key
# ============================================

# ============================================
# API 配置（必填）
# ============================================

# MiMO API 配置（模力方舟）
MIMO_API_KEY=your_mimo_api_key_here
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2-flash

# DeepSeek API 配置（可选）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# LLM 流控配置
# RPM: 每分钟最大请求数 (默认: 100)
# TPM: 每分钟最大 token 数 (默认: 10000000, 即 10M)
LLM_RPM=100
LLM_TPM=10000000

# Gitee AI API 配置（用于嵌入和重排模型）
GITEE_AI_API_KEY=your_gitee_ai_key_here
GITEE_AI_BASE_URL=https://ai.gitee.com/v1
EMBEDDING_MODEL=bge-m3
RERANK_MODEL=bge-reranker-v2-m3

# ============================================
# SSL 配置
# ============================================
# SSL验证总开关（默认开启）
SSL_VERIFY=true
# MiMO模型SSL验证（默认开启）
SSL_VERIFY_MIMO=true
# Gitee AI（嵌入/重排）SSL验证（如遇证书问题可设为false）
SSL_VERIFY_GITEE_AI=true

# ============================================
# 应用配置
# ============================================
# 生产环境必须设置为 false
DEBUG=false
# 生产环境请更换为随机生成的强密钥
SECRET_KEY=your_secret_key_here
# 允许的主机名，* 表示允许所有主机
# 生产环境建议设置为具体域名，格式: domain1,domain2,ip1,ip2
ALLOWED_HOSTS=*

# ============================================
# 日志级别配置
# ============================================
# 可选值: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO                  # 全局默认级别
LOG_LEVEL_DB=WARNING            # 数据库层 (postgres, neo4j)
LOG_LEVEL_SERVICE=INFO          # 服务层 (services/)
LOG_LEVEL_API=INFO              # API 层 (api/v1/endpoints/)
LOG_LEVEL_LLM=INFO              # LLM 服务单独控制
LOG_LEVEL_KG=INFO               # 知识图谱服务单独控制
LOG_LEVEL_RAG=INFO              # RAG 服务单独控制
LOG_LEVEL_UVICORN=WARNING       # 第三方: uvicorn
LOG_LEVEL_SQLALCHEMY=WARNING    # 第三方: sqlalchemy
LOG_LEVEL_NEO4J_DRIVER=WARNING  # 第三方: neo4j 驱动

# ============================================
# 数据库配置（生产环境必须修改密码！）
# ============================================
POSTGRES_PASSWORD=your_strong_postgres_password
NEO4J_PASSWORD=your_strong_neo4j_password

# ============================================
# 文件存储配置
# ============================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800
