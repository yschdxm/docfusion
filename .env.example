# ============================================
# 环境变量配置模板
# 复制此文件为 .env 并填写真实的 API key
# ============================================

# ============================================
# API 配置（开发环境使用）
# ============================================

# MiMO API 配置（模力方舟）
MIMO_API_KEY=your_mimo_api_key_here
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2-flash

# Gitee AI API 配置（用于嵌入和重排模型）
GITEE_AI_API_KEY=your_gitee_ai_key_here
GITEE_AI_BASE_URL=https://ai.gitee.com/v1
EMBEDDING_MODEL=bge-m3
RERANK_MODEL=bge-reranker-v2-m3

# ============================================
# SSL 配置
# ============================================
# SSL验证总开关（默认开启）
SSL_VERIFY=true
# MiMO模型SSL验证（默认开启）
SSL_VERIFY_MIMO=true
# Gitee AI（嵌入/重排）SSL验证（如遇证书问题可设为false）
SSL_VERIFY_GITEE_AI=true

# ============================================
# 应用配置
# ============================================
DEBUG=true
SECRET_KEY=your_secret_key_here

# ============================================
# 日志级别配置
# ============================================
# 可选值: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO                  # 全局默认级别
# LOG_LEVEL_DB=WARNING            # 数据库层 (postgres, mongodb, neo4j)
# LOG_LEVEL_SERVICE=INFO          # 服务层 (services/)
# LOG_LEVEL_API=INFO              # API 层 (api/v1/endpoints/)
# LOG_LEVEL_LLM=INFO              # LLM 服务单独控制
# LOG_LEVEL_KG=INFO               # 知识图谱服务单独控制
# LOG_LEVEL_RAG=INFO              # RAG 服务单独控制
# LOG_LEVEL_UVICORN=WARNING       # 第三方: uvicorn
# LOG_LEVEL_SQLALCHEMY=WARNING    # 第三方: sqlalchemy
# LOG_LEVEL_NEO4J_DRIVER=WARNING  # 第三方: neo4j 驱动
# LOG_LEVEL_MOTOR=WARNING         # 第三方: motor/pymongo
# LOG_LEVEL_REDIS=WARNING         # 第三方: redis
# LOG_LEVEL_CELERY=WARNING        # 第三方: celery

# ============================================
# 数据库配置（开发环境）
# ============================================
POSTGRES_URL=postgresql://docfusion:your_postgres_password@localhost:5432/docfusion
MONGODB_URL=mongodb://localhost:27017/docfusion
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

# ============================================
# Celery 配置
# ============================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ============================================
# 文件存储配置
# ============================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800
